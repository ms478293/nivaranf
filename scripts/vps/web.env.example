# Nivaran Foundation web app environment for VPS production
# Copy to /etc/nivaran/web.env and fill the real values before the first build.

NODE_ENV=production
PORT=3000
APP_HOST=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# Public URLs
NEXT_PUBLIC_SITE_URL=https://www.nivaranfoundation.org
NEXT_PUBLIC_APP_URL=https://www.nivaranfoundation.org
NEXT_PUBLIC_API_BASE_URL=https://api.nivaranfoundation.org
AUTH_API_BASE_URL=https://api.nivaranfoundation.org

# Optional: keep disabled once you leave Vercel
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=
RESEND_OFFICIAL_FROM_EMAIL=
RESEND_OFFICIAL_REPLY_TO=
RESEND_PERSONAL_API_KEY=
RESEND_PERSONAL_FROM_EMAIL=
RESEND_PERSONAL_REPLY_TO=

# Payments
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=

# Security / auth
IPINFO_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CONTENT_PORTAL_USERNAME=
CONTENT_PORTAL_PASSWORD=
CONTENT_PORTAL_SESSION_SECRET=

# Optional legacy/news automation values if you run those on the same VPS
GEMINI_API_KEY=
GLOBAL_NEWS_DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
