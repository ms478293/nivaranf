# Nivaran Foundation web app environment for VPS production
# Copy to /etc/nivaran/web.env and fill the real values before the first build.

NODE_ENV=production
PORT=3000
APP_HOST=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# Public URLs
NEXT_PUBLIC_SITE_URL=https://www.nivaranfoundation.org
NEXT_PUBLIC_APP_URL=https://www.nivaranfoundation.org
NEXT_PUBLIC_API_BASE_URL=https://api.nivaranfoundation.org
AUTH_API_BASE_URL=https://api.nivaranfoundation.org

# Optional: keep disabled once you leave Vercel
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=
RESEND_OFFICIAL_FROM_EMAIL=
RESEND_OFFICIAL_REPLY_TO=
RESEND_PERSONAL_API_KEY=
RESEND_PERSONAL_FROM_EMAIL=
RESEND_PERSONAL_REPLY_TO=

# Payments: GoDaddy Payments / Poynt (values live in VPS .env.runtime; do not commit them)
# GD_BUSINESS_ID=            # business UUID from GoDaddy Payments HQ
# GD_APP_ID=                 # urn:aid:... from Advanced Tools > Business Settings > Poynt Collect API Settings
# GD_PRIVATE_KEY_B64=        # base64 of the downloaded RSA private key PEM (base64 -w0 key.pem)
# GD_API_BASE=https://services.poynt.net
# NEXT_PUBLIC_GD_BUSINESS_ID= # same as GD_BUSINESS_ID (inlined at build time)
# NEXT_PUBLIC_GD_APP_ID=      # same as GD_APP_ID (inlined at build time)

# Security / auth
IPINFO_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CONTENT_PORTAL_USERNAME=
CONTENT_PORTAL_PASSWORD=
CONTENT_PORTAL_SESSION_SECRET=

# Optional legacy/news automation values if you run those on the same VPS
GEMINI_API_KEY=
GLOBAL_NEWS_DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Outbound mail: Zoho SMTP (preferred; Resend account is suspended as of 2026-09-12)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USER=                 # Zoho mailbox that owns the donations@ alias (e.g. support@nivaranfoundation.org)
# SMTP_PASS=                 # Zoho app-specific password for that mailbox
# MAIL_FROM="Nivaran Foundation <donations@updates.nivaranfoundation.org>"  # forced From for ALL site mail (domain must be verified with the transport)
# DONATION_NOTIFY_EMAIL=     # internal alert inbox for new donations (default support@nivaranfoundation.org)
# RESEND_API_KEY=            # legacy fallback, only used when SMTP_HOST is unset
